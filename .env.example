# Copy to .env and fill in. Never commit the real .env.

# LLM key (used by config/models.yaml -> api_key_env: NEOVIS_API_KEY).
# For Anthropic public API this is your Anthropic key; for a company proxy,
# whatever token the proxy expects.
NEOVIS_API_KEY=

# --- Slack (Stage 1 gateway; needed only when running the Slack channel) ---
# App-level token (xapp-...) with connections:write, for Socket Mode.
SLACK_APP_TOKEN=
# Bot token (xoxb-...).
SLACK_BOT_TOKEN=

# Optional: override which config dir Neovis reads.
# NEOVIS_CONFIG_DIR=/path/to/config
